---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
{%- assign last_char = p.url | slice: -1 %}
{%- if last_char == "/" %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
